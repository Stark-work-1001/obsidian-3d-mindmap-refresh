{
  "name": "obsidian-3d-mindmap-refresh",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Editable 3D mind maps from Markdown outlines for Obsidian, with a Rust/WASM layout engine.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:js": "node scripts/build.mjs --js-only",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:rust": "cargo test --manifest-path crates/graph-physics/Cargo.toml",
    "test:ui": "node scripts/ui-smoke.mjs",
    "check": "npm run typecheck && npm test && node scripts/check-english.mjs --no-bundle",
    "check:strings": "node scripts/check-english.mjs",
    "bench": "node scripts/bench.mjs",
    "package": "node scripts/check-english.mjs && node scripts/package.mjs",
    "install:vault": "node scripts/install-to-vault.mjs",
    "licenses:rust": "node scripts/rust-licenses.mjs",
    "version": "node scripts/sync-version.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "katex": "0.16.47",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/three": "0.160.0",
    "esbuild": "0.25.12",
    "obsidian": "1.14.4",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "wasm-pack": "0.15.0"
  }
}
